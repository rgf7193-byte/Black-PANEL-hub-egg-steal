local function atualizarCanvas() task.wait() _G.EggScroll.CanvasSize = UDim2.new(0, 0, 0, _G.ScrollLayout.AbsoluteContentSize.Y + 12) end
local function criarAssinatura()
    local encontrados = {} for _, egg in ipairs(AreaFolder:GetChildren()) do if _G.estaNaArea(egg) and _G.temParticula(egg) then local tipo = _G.getEggType(egg) local pos = _G.getEggPosition(egg) if tipo and pos then table.insert(encontrados, string.format("%s|%.1f|%.1f|%.1f", tipo, pos.X, pos.Y, pos.Z)) end end end table.sort(encontrados) return table.concat(encontrados, ";;")
end

local UltimaAssinatura = ""
_G.atualizarLista = function(forcar)
    local assinatura = criarAssinatura() if not forcar and assinatura == UltimaAssinatura then return end UltimaAssinatura = assinatura
    for _, child in ipairs(_G.EggScroll:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    local tiposAdicionados, eggs = {}, {}
    for _, egg in ipairs(AreaFolder:GetChildren()) do if _G.estaNaArea(egg) and _G.temParticula(egg) then local tipo = _G.getEggType(egg) if tipo and tipo ~= "" and not tiposAdicionados[tipo] then tiposAdicionados[tipo] = true table.insert(eggs, {Instance = egg, Tipo = tipo}) end end end
    table.sort(eggs, function(a, b) return a.Tipo:lower() < b.Tipo:lower() end)
    for _, data in ipairs(eggs) do if data.Instance and data.Instance.Parent and _G.estaNaArea(data.Instance) and _G.temParticula(data.Instance) then _G.criarCaixinhaEgg(data.Instance, data.Tipo) end end
    atualizarCanvas()
end

