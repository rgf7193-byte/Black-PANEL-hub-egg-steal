_G.mostrarModelo = function(viewport, egg)
    viewport:ClearAllChildren() if not egg then return end
    
    local antigoArchivable = egg.Archivable 
    egg.Archivable = true 
    
    local clone = nil
    pcall(function() clone = egg:Clone() end) 
    egg.Archivable = antigoArchivable 
    
    if not clone then return end 
    clone.Parent = viewport
    
    local Camera = Instance.new("Camera") 
    Camera.Parent = viewport 
    viewport.CurrentCamera = Camera
    
    if clone:IsA("Model") then 
        local part = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true) 
        if part then Camera.CFrame = CFrame.new(part.Position + Vector3.new(0, 0, 4), part.Position) end
    elseif clone:IsA("BasePart") then 
        Camera.CFrame = CFrame.new(clone.Position + Vector3.new(0, 0, 4), clone.Position) 
    end
end

local function processarPromptUnico(prompt)
    if not prompt:IsA("ProximityPrompt") then return end
    prompt.HoldDuration = 0 
    prompt.RequiresLineOfSight = false
    if prompt.Enabled then 
        task.spawn(function() 
            if fireproximityprompt then 
                fireproximityprompt(prompt) 
            else 
                prompt:InputHoldBegin() 
                task.wait() 
                prompt:InputHoldEnd() 
            end 
        end) 
    end
end

_G.varrerPromptsApenasPertoDeMim = function(hrp, raioCustomizado)
    if not hrp then return end
    local raio = raioCustomizado or 7
    for _, prompt in ipairs(workspace:GetDescendants()) do 
        if prompt:IsA("ProximityPrompt") and prompt.ClassName == "ProximityPrompt" then 
            local partPai = prompt.Parent:IsA("BasePart") and prompt.Parent or prompt.Parent:FindFirstChildWhichIsA("BasePart", true)
            if partPai then
                local distancia = (partPai.Position - hrp.Position).Magnitude
                if distancia <= raio then
                    processarPromptUnico(prompt)
                end
            end
        end 
    end 
end
