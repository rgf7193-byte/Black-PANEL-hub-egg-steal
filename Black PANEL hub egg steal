_G.pararMovimento = function()
    _G.Moving = false
    if _G.MoveConnection then
        _G.MoveConnection:Disconnect()
        _G.MoveConnection = nil
    end
    if _G.loopCorrida then
        _G.loopCorrida:Disconnect()
        _G.loopCorrida = nil
    end
    if _G.loopColetaSegundoTP then
        _G.loopColetaSegundoTP:Disconnect()
        _G.loopColetaSegundoTP = nil
    end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if hrp then
        hrp.Anchored = false
        local lv = hrp:FindFirstChild("DeltaVelocity")
        local attachment = hrp:FindFirstChild("DeltaAttachment")
        if lv then lv:Destroy() end
        if attachment then attachment:Destroy() end
    end
    if hum then 
        hum.PlatformStand = false 
        workspace.CurrentCamera.CameraSubject = hum
    end
end

_G.executarCicloDoEgg = function(char, hrp, eggCoord)
    local travaEgg = RunService.Heartbeat:Connect(function()
        if hrp and hrp.Parent then
            hrp.CFrame = CFrame.new(eggCoord)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end)

    -- 1. FICA PARADO POR EXATAMENTE 1 SEGUNDO NA COORDENADA DO EGG DO PAINEL
    task.wait(1.0)
    
    -- 2. ATIVA O COLETOR PERTO DE VOCÊ (DISTÂNCIA CURTA PRO OVO DO PAINEL)
    _G.varrerPromptsApenasPertoDeMim(hrp, 7)
    
    -- 3. CONTAGEM DE 0.5 SEGUNDOS PEDIDA
    task.wait(0.5)
    
    if travaEgg then travaEgg:Disconnect() end

    -- ======================================================
    -- SEU SISTEMA DE TPs COM REPETIÇÃO CONTÍNUA DO LAÇO DE COLETAS
    -- ======================================================
    local c1 = Vector3.new(604.9, 70.6, -295.1)
    local c2 = Vector3.new(549.6, 70.6, -296.9)

    -- ATALHOS BÁSICOS
    local p = game.Players.LocalPlayer
    char = p.Character
    local root = char.HumanoidRootPart
    local hum = char.Humanoid

    ---------------------------------------------------------
    -- CICLO 1: INICIA DIRETO AO EXECUTAR
    ---------------------------------------------------------
    root.CFrame = CFrame.new(c1)

    hum.BreakJointsOnDeath = false
    local fake1 = Instance.new("Humanoid")
    fake1.Name = "FakeHumanoid"
    hum.Parent = nil
    fake1.Parent = char

    -- Heartbeat bruto para gravar no chão
    local hb1
    hb1 = game:GetService("RunService").Heartbeat:Connect(function()
        root.CFrame = CFrame.new(c1)
        root.Velocity = Vector3.new(0,0,0)
    end)

    -- Aguarda 0.65 segundos para o drop
    task.wait(0.65)
    hum.Health = 0
    char:BreakJoints() -- VOCÊ MORREU AQUI

    ---------------------------------------------------------
    -- PARADA TOTAL: APÓS A MORTE NÃO FAZ MAIS NADA POR 2.7 SEGUNDOS
    ---------------------------------------------------------
    hb1:Disconnect()
    fake1:Destroy()  
    hum.Parent = char

    task.wait(2.7)

    ---------------------------------------------------------
    -- O SEGUNDO TP: TRAVA IMORTAL COM MARTELADA REPETIDA DE CLIQUES
    ---------------------------------------------------------
    char = p.Character or p.CharacterAdded:Wait()
    root = char:WaitForChild("HumanoidRootPart")
    hum = char:WaitForChild("Humanoid")

    -- Vira humanoide fake imortal para o ciclo 2
    hum.BreakJointsOnDeath = false
    local fake2 = Instance.new("Humanoid")
    fake2.Name = "FakeHumanoid"
    hum.Parent = nil
    fake2.Parent = char

    -- Liga o Heartbeat bruto para travar no chão na coordenada de novo
    local hb2
    hb2 = game:GetService("RunService").Heartbeat:Connect(function()
        root.CFrame = CFrame.new(c1)
        root.Velocity = Vector3.new(0,0,0)
    end)

    -- Dá o segundo TP na coordenada C1
    root.CFrame = CFrame.new(c1)
    task.wait(0.05)

    -- Limpa instâncias antigas de loops repetidos para não dar conflito na segunda vez
    if _G.loopColetaSegundoTP then
        _G.loopColetaSegundoTP:Disconnect()
        _G.loopColetaSegundoTP = nil
    end

    -- MUDANÇA PRINCIPAL: Loop contínuo frame a frame forçando a coleta durante todo o tempo travado
    _G.loopColetaSegundoTP = game:GetService("RunService").Heartbeat:Connect(function()
        for _, prompt in pairs(workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                local nomePrompt = prompt.Name:lower()
                local nomePai = prompt.Parent and prompt.Parent.Name:lower() or ""
                
                -- Se o prompt pertencer a uma loja, roleta ou menu de evento, ignora
                if not (string.find(nomePrompt, "shop") or string.find(nomePai, "shop") or
                        string.find(nomePrompt, "store") or string.find(nomePai, "store") or
                        string.find(nomePrompt, "loja") or string.find(nomePai, "loja") or
                        string.find(nomePrompt, "buy") or string.find(nomePai, "buy") or
                        string.find(nomePrompt, "sell") or string.find(nomePai, "sell") or
                        string.find(nomePrompt, "event") or string.find(nomePai, "event")) then
                    
                    prompt.HoldDuration = 0
                    task.spawn(function()
                        if fireproximityprompt then 
                            fireproximityprompt(prompt) 
                        else 
                            prompt:InputHoldBegin() 
                            task.wait() 
                            prompt:InputHoldEnd() 
                        end 
                    end)
                end
            end
        end
    end)

    -- Fica martelando a coleta e travado no chão por exatamente 0.50 segundos seguros
    task.wait(0.45)

    -- Acabou o tempo de 0.50s total: desliga os laços de coleta, trava e volta ao normal
    if _G.loopColetaSegundoTP then
        _G.loopColetaSegundoTP:Disconnect()
        _G.loopColetaSegundoTP = nil
    end
    hb2:Disconnect()
    fake2:Destroy()
    hum.Parent = char

    -- TP DE 20 STUDS PARA CIMA E CORRIDA SPEED 100 ATÉ A COORDENADA FINAL C2
    root.CFrame = root.CFrame + Vector3.new(0, 20, 0)
    task.wait()

    local hbCorrida
    hbCorrida = game:GetService("RunService").Heartbeat:Connect(function(dt)
        local pos = root.Position
        local dist = (c2 - pos).Magnitude
        
        if dist < 2 then
            root.CFrame = CFrame.new(c2)
            hbCorrida:Disconnect()
        else
            local dir = (c2 - pos).Unit
            root.CFrame = CFrame.lookAt(pos + (dir * 100 * dt), pos + dir)
        end
    end)
end

_G.irParaEgg = function()
    if _G.Moving then _G.pararMovimento() return end
    if not _G.Marcado then return end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    _G.Moving = true
    hum.PlatformStand = true 

    local attachment = hrp:FindFirstChild("DeltaAttachment") or Instance.new("Attachment")
    attachment.Name = "DeltaAttachment"
    attachment.Parent = hrp

    local lv = hrp:FindFirstChild("DeltaVelocity") or Instance.new("LinearVelocity")
    lv.Name = "DeltaVelocity"
    lv.MaxForce = 999999
    lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    lv.Attachment0 = attachment
    lv.Parent = hrp

    _G.MoveConnection = RunService.Heartbeat:Connect(function()
        if not _G.Moving or not _G.Marcado or not _G.Marcado.Parent or not hrp.Parent then _G.pararMovimento() return end
        local target = _G.getEggPosition(_G.Marcado)
        if not target then _G.pararMovimento() return end

        local direcao = target - hrp.Position
        local distancia = direcao.Magnitude

        if distancia <= 4.5 then
            _G.MoveConnection:Disconnect()
            _G.MoveConnection = nil
            _G.Moving = false
            
            lv:Destroy()
            attachment:Destroy()
            hum.PlatformStand = false

            task.spawn(function()
                _G.executarCicloDoEgg(char, hrp, target)
            end)
            return
        end

        lv.VectorVelocity = direcao.Unit * 270
    end)
end 
