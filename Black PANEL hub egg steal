_G.getEggPosition = function(egg)
    if not egg or not egg.Parent then return nil end
    if egg:IsA("Model") then return egg:GetPivot().Position end
    if egg:IsA("BasePart") then return egg.Position end
    local part = egg:FindFirstChildWhichIsA("BasePart", true)
    if part then return part.Position end
    return nil
end

_G.temParticula = function(egg)
    if not egg then return false end
    return egg:FindFirstChildWhichIsA("ParticleEmitter", true) ~= nil 
        or egg:FindFirstChildWhichIsA("Sparkles", true) ~= nil 
        or egg:FindFirstChildWhichIsA("Smoke", true) ~= nil
        or egg:FindFirstChildWhichIsA("Fire", true) ~= nil
end

_G.estaNaArea = function(egg)
    local pos = _G.getEggPosition(egg)
    if not pos then return false end
    return pos.X >= _G.MIN_X and pos.X <= _G.MAX_X and pos.Z >= _G.MIN_Z and pos.Z <= _G.MAX_Z
end

local function limparAreaDeEggsComuns()
    for _, egg in ipairs(AreaFolder:GetChildren()) do
        if _G.estaNaArea(egg) and not _G.temParticula(egg) then
            egg:Destroy()
        end
    end
end

limparAreaDeEggsComuns()
AreaFolder.ChildAdded:Connect(function()
    task.wait(0.05)
    limparAreaDeEggsComuns()
end)

_G.getEggType = function(egg)
    local attributes = {"EggName", "EggType", "DisplayName", "ModelName"}
    for _, name in ipairs(attributes) do
        local value = egg:GetAttribute(name)
        if value ~= nil and tostring(value) ~= "" then return tostring(value) end
    end
    local values = {"EggName", "EggType", "DisplayName", "ModelName"}
    for _, name in ipairs(values) do
        local obj = egg:FindFirstChild(name, true)
        if obj and obj:IsA("StringValue") and obj.Value ~= "" then return obj.Value end
    end
    return egg.Name:gsub("_%d+$", ""):gsub("%s*%(%d+%)$", ""):gsub("%s+%d+$", "")
end

_G.getEggRarity = function(egg)
    local names = {"Rarity", "Raridade", "EggRarity", "RarityName"}
    for _, name in ipairs(names) do
        local value = egg:GetAttribute(name)
        if value ~= nil and tostring(value) ~= "" then return tostring(value) end
    end
    for _, name in ipairs(names) do
        local obj = egg:FindFirstChild(name, true)
        if obj and obj:IsA("StringValue") and obj.Value ~= "" then return obj.Value end
    end
    return "Desconhecida"
end
